PORT=3000
LOG_LEVEL=info
STORE_BACKEND=sqlite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cdt
SQLITE_PATH=./data/app.db
# Set REDIS_URL to enable Redis-backed design locks (falls back to in-memory locks locally when unset).
# Required on Vercel (Production and Test).
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=cdt
ARTIFACT_STORAGE_BACKEND=file
ARTIFACTS_DIR=./artifacts
EXPORT_MAX_ATTEMPTS=3
EXPORT_RETRY_BASE_MS=500
EXPORT_ARTIFACT_RETENTION_DAYS=30
EXPORT_STALE_PROCESSING_MS=300000
EXPORT_SAME_REQUEST_RETRY_BUDGET_MS=10000
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
S3_PUBLIC_BASE_URL=
S3_SIGNED_DOWNLOADS=false
S3_SIGNED_DOWNLOAD_TTL_SECONDS=900
# Vercel Blob (Hobby): set ARTIFACT_STORAGE_BACKEND=blob. Token is injected when a Blob store is linked.
# BLOB_READ_WRITE_TOKEN=
# BLOB_KEY_PREFIX=cdt
REQUIRE_ROLE_HEADER=false
REQUIRE_USER_HEADER=false
ENABLE_LEGACY_HEADER_AUTH=false
ADMIN_EMAILS=meckert@vpc.com,cpq-import@vpc.com
SESSION_TTL_HOURS=336
# Required on Vercel so cron/maintenance calls are authenticated. Auto-sent as Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=
# Optional override if the XLSX template is not next to the function cwd.
# WIRELIST_TEMPLATE_PATH=
