{
  "name": "new-project",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:web\"",
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix apps/web run build",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/server.js",
    "start:web": "npm --prefix apps/web run start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:web": "npm --prefix apps/web run lint",
    "test:web": "npm --prefix apps/web run test",
    "test:web:e2e": "npm --prefix apps/web run test:e2e",
    "import:cpq": "tsx scripts/import-cpq.ts",
    "import:connector-compat": "tsx scripts/import-connector-compat.ts",
    "import:vpc-catalog": "tsx scripts/import-vpc-catalog.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:sqlite": "tsx scripts/migrate-sqlite.ts",
    "maintenance": "tsx scripts/run-maintenance.ts",
    "test:validation": "node --import tsx --test src/domain/validator.test.ts src/domain/validator.fixtures.test.ts src/domain/library.test.ts src/domain/library-compatibility.test.ts src/domain/compat-lookup.test.ts src/domain/bom.test.ts src/domain/connector-frames.test.ts src/domain/cpq-import/normalize.test.ts src/domain/cpq-import/builders.test.ts src/domain/vpc-catalog-import/parse.test.ts src/domain/wirelist-xlsx-export.test.ts src/services/export-queue.test.ts src/infra/observability/observability.test.ts src/infra/env/load-dotenv.test.ts src/infra/env/hosted-config.test.ts src/infra/storage/blob-artifact-storage.test.ts src/infra/store/memory-store.library.test.ts",
    "test:api": "node --import tsx --test src/routes/api.integration.test.ts src/routes/auth.integration.test.ts src/routes/library-bulk.integration.test.ts src/infra/store/sqlite-store.integration.test.ts src/infra/store/postgres-store.integration.test.ts",
    "test": "npm run test:validation && npm run test:api && npm run test:web"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1018.0",
    "@aws-sdk/s3-request-presigner": "^3.1018.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/sensible": "^6.0.4",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.3",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.8.4",
    "ioredis": "^5.10.1",
    "jszip": "^3.10.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
