{
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "data/**",
      "excludeFiles": "{src/infra/store/sqlite-store.ts,src/infra/auth/sqlite-auth-store.ts,scripts/migrate-sqlite.ts}"
    }
  },
  "crons": [
    {
      "path": "/v1/internal/maintenance",
      "schedule": "0 4 * * *"
    }
  ]
}
